<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Burger Menu' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <%
    const fallbackItems = [
      { name: 'Classic Veg Burger', price: 149, image: 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=1200&q=80', description: 'Crispy patty with fresh veggies.' },
      { name: 'Cheese Blast Burger', price: 179, image: 'https://images.unsplash.com/photo-1571091718767-18b5b1457add?auto=format&fit=crop&w=1200&q=80', description: 'Double cheese melt and soft bun.' },
      { name: 'Paneer Tikka Burger', price: 199, image: 'https://images.unsplash.com/photo-1610970878459-a0e464d7592b?auto=format&fit=crop&w=1200&q=80', description: 'Smoky paneer tikka flavor.' }
    ];

    const restaurantData = restaurant || {
      name: 'Burger Junction',
      diningRating: 4.0,
      deliveryRating: 4.3,
      description: 'Juicy burgers and loaded fries',
      banner1: 'https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=1400&q=80'
    };

    const items = (menu && menu.length) ? menu : fallbackItems;
  %>

  <main class="pizza-page compact-hero-page">
    <section class="pizza-hero">
      <div class="pizza-hero-content">
        <p class="pizza-eyebrow">Freshly Grilled</p>
        <h1><%= restaurantData.name %></h1>
        <p class="pizza-subtitle"><%= restaurantData.description %></p>

        <div class="pizza-ratings">
          <div class="pizza-rating-card">
            <span>Dining</span>
            <strong><%= restaurantData.diningRating || '4.0' %> ★</strong>
          </div>
          <div class="pizza-rating-card">
            <span>Delivery</span>
            <strong><%= restaurantData.deliveryRating || '4.0' %> ★</strong>
          </div>
        </div>
      </div>

      <div class="pizza-hero-art">
        <img
          src="<%= restaurantData.banner1 %>"
          alt="Fresh burger"
          onerror="this.src='https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=1200&q=80'"
        >
      </div>
    </section>

    <section class="pizza-menu-wrap">
      <div class="pizza-menu-header">
        <h2>Signature Burgers</h2>
        <div class="pizza-chip-row" aria-label="Popular tags">
          <span class="pizza-chip">Best Seller</span>
          <span class="pizza-chip">Cheesy</span>
          <span class="pizza-chip">Spicy</span>
          <span class="pizza-chip">Grilled</span>
        </div>
      </div>

      <div class="pizza-grid">
        <% items.forEach((item) => { %>
          <article class="pizza-card">
            <div class="pizza-img-wrap">
              <img
                src="<%= item.image %>"
                class="pizza-img"
                alt="<%= item.name %>"
                onerror="this.src='https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=1200&q=80'"
              >
            </div>

            <div class="pizza-info">
              <h3><%= item.name %></h3>
              <p><%= item.description || 'Loaded and delicious burger.' %></p>
              <div class="pizza-card-bottom">
                <span class="pizza-price">₹ <%= item.price %></span>
                <div
                  class="item-cart-controls"
                  data-name="<%= item.name %>"
                  data-price="<%= item.price %>"
                  data-image="<%= item.image %>"
                >
                  <button type="button" class="pizza-minus-btn">-</button>
                  <span class="pizza-item-count">0</span>
                  <button type="button" class="pizza-add-btn pizza-plus-btn">Add +</button>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  </main>

  <script src="/js/menu-cart.js"></script>
  <%- include('partials/footer') %>
</body>
</html>
