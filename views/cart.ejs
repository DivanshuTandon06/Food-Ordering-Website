<%- include('partials/header') %>

<main class="cart-container">
    <h1 class="cart-title">Your Food Basket</h1>

    <div class="cart-wrapper">
        <div class="cart-items">
            <table class="cart-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="product-info">
                            <img src="/images/pizza-icon.png" alt="Margherita Pizza">
                            <div>
                                <h3>Margherita Pizza</h3>
                                <p>Extra Cheese</p>
                            </div>
                        </td>
                        <td>₹299</td>
                        <td>
                            <div class="qty-btn">
                                <button>-</button>
                                <span>1</span>
                                <button>+</button>
                            </div>
                        </td>
                        <td>₹299</td>
                        <td><i class="fa-solid fa-trash remove-icon"></i></td>
                    </tr>
                </tbody>
            </table>
            <a href="/explore" class="continue-shopping">← Continue Ordering</a>
        </div>

        <div class="cart-summary">
            <h3>Bill Details</h3>
            <div class="summary-row">
                <span>Item Total</span>
                <span>₹299</span>
            </div>
            <div class="summary-row">
                <span>Delivery Fee</span>
                <span>₹30</span>
            </div>
            <div class="summary-row">
                <span>Govt Taxes</span>
                <span>₹15</span>
            </div>
            <hr>
            <div class="summary-row total">
                <span>Total Amount</span>
                <span>₹344</span>
            </div>
            <button class="checkout-btn">Proceed to Checkout</button>
        </div>
    </div>
</main>

<%- include('partials/footer') %>