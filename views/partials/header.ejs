<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
  
  <nav class="navbar">
  <div class="logo">
  <a href="/">  <img src="/images/logo.png" alt="Logo" height="60px">
  </a>
  </div>

  <div class="search-container">
    <div class="input-group">
      <i class="fas fa-map-marker-alt"></i>
      <input type="text" placeholder="Your location">
    </div>

    <div class="input-group search-bar">
      <i class="fas fa-search"></i>
      <input type="text" placeholder="Search for food">
    </div>
  </div>

  <ul class="nav-links">
    <li><a href="/">Home</a></li>
    <li><a onclick="offerLink()" href="/">Offers % </a></li>
    
    <% if (user) { %>
        <li><a href="/profile"><i class="fa-solid fa-user"></i> Profile</a></li>
        <li><a href="/logout" class="logout-link">Logout</a></li>
    <% } else { %>
        <li><a href="/signin">Sign-In</a></li>
    <% } %>
    
    <li><a href="/cart"><i class="fas fa-shopping-cart"></i> Cart</a></li>
</ul>
</nav>
</header>
 <script> function offerLink() {
        alert("Today's Offer: 20% off on all items!");
        }
</script>

</body>
</html>