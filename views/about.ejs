<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('partials/header') %>

<main class="content-page about-page">
  <section class="content-hero">
    <p class="content-eyebrow">Who We Are</p>
    <h1>Food made with speed, care, and a little obsession.</h1>
    <p class="content-lead">
      We bring together restaurant-style quality, reliable delivery, and simple ordering so every meal feels easy.
    </p>
  </section>

  <section class="content-grid">
    <article class="content-card">
      <h2>Our Mission</h2>
      <p>To make hot, fresh food accessible with a smooth experience from browsing to checkout.</p>
    </article>
    <article class="content-card">
      <h2>What We Value</h2>
      <p>Consistency, transparent pricing, and food that arrives the way it should: fast and fresh.</p>
    </article>
    <article class="content-card">
      <h2>How We Work</h2>
      <p>We partner with curated kitchens, maintain clear menus, and keep your orders organized in one place.</p>
    </article>
  </section>

  <section class="stats-strip">
    <div>
      <strong>100+</strong>
      <span>Curated dishes</span>
    </div>
    <div>
      <strong>30 min</strong>
      <span>Average delivery goal</span>
    </div>
    <div>
      <strong>24/7</strong>
      <span>Support-ready experience</span>
    </div>
  </section>
</main>

<%- include('partials/footer') %>

</body>
</html>
