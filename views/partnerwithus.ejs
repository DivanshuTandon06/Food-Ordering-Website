<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('partials/header') %>

<main class="content-page partner-page">
  <section class="content-hero">
    <p class="content-eyebrow">Partner with Us</p>
    <h1>Bring your food brand to more customers with a better ordering experience.</h1>
    <p class="content-lead">
      We work with kitchens, restaurants, and delivery partners who value quality, consistency, and growth.
    </p>
  </section>

  <section class="content-grid partner-grid">
    <article class="content-card">
      <h2>For Restaurants</h2>
      <p>List your menu, reach new customers, and manage orders in one place.</p>
    </article>
    <article class="content-card">
      <h2>For Kitchens</h2>
      <p>Join as a kitchen partner and scale with curated categories and delivery support.</p>
    </article>
    <article class="content-card">
      <h2>For Vendors</h2>
      <p>Collaborate with us on packaging, supplies, logistics, and local food programs.</p>
    </article>
  </section>

  <section class="partner-cta">
    <div>
      <h2>Want to get started?</h2>
      <p>Reach out with your business details and we’ll connect with you next.</p>
    </div>
    <a href="/contact" class="partner-button">Contact Us</a>
  </section>
</main>

<%- include('partials/footer') %>

</body>
</html>
